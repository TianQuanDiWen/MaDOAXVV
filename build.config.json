{
    "projectName": "MaDOAXVV",
    "defaultTarget": "win-x86_64",
    "dependencies": {
        "maaFramework": {
            "repository": "MaaXYZ/MaaFramework",
            "release": "latest",
            "assetPattern": "MAA-{platform}-{arch}*"
        },
        "mxu": {
            "repository": "MistEO/MXU",
            "release": "latest",
            "assetPattern": "*{platform}-{arch}*"
        }
    },
    "toolchain": {
        "goVersion": "1.24.x",
        "pythonVersion": "3.12",
        "uvIndex": "https://pypi.org/simple"
    },
    "agent": {
        "source": "./agent/cmd/madoaxvv-agent",
        "output": "agent/MaDOAXVV.Agent{exe}"
    },
    "directories": {
        "output": "install",
        "dependencies": "deps",
        "downloads": "downloads",
        "cache": "cache/downloads"
    },
    "packageName": "{project}-{platform}-{arch}-{version}.zip",
    "targets": [
        {
            "runner": "ubuntu-latest",
            "platform": "win",
            "arch": "x86_64"
        }
    ]
}
