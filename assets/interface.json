{
    "interface_version": 2,
    "name": "MaDOAXVV",
    "icon": "icon.png",
    "logo": "logo.png",
    "theme_color": "#2EA7E0",
    "accent_color": "维纳斯蓝",
    "description": "**✨ 《死或生：沙滩排球女神假期》自动化日常助手 · 基于 MaaFramework ✨**\n\n[🏖️ 前往 GitHub 仓库](https://github.com/TianQuanDiWen/MaDOAXVV) ｜ [💡 问题与建议反馈](https://github.com/TianQuanDiWen/MaDOAXVV/issues)\n\n_如果觉得好用，欢迎在 GitHub 点亮一颗小星星 🌟 鼓励作者！_\n\n---\n🛡️ 本软件永久免费开源（AGPL-3.0），严禁用于倒卖牟利或收费代练。",
    "contact": "[前往 GitHub Issues 提交反馈](https://github.com/TianQuanDiWen/MaDOAXVV/issues)",
    "license": "AGPL-3.0",
    "welcome": "### 🏖️ 欢迎使用 MaDOAXVV！\n基于 **MaaFramework** 开发的《DEAD OR ALIVE Xtreme Venus Vacation》全自动日常助手，助你轻松解放双手。\n\n> **📢 免费与开源声明**  \n> 本项目遵循 AGPL-3.0 协议**完全免费开源**，严禁任何形式的倒卖、转售或收费代练。若您通过付费途径购得，请立即维权退款并举报商家！\n\n> **⚠️ 使用提示与免责**  \n> 软件基于图像识别与模拟操作，仅供个人学习研究与日常减负使用，使用风险由使用者自行评估承担。\n\n---\n⭐ **开源不易**：如果 MaDOAXVV 帮您节省了日常时间，欢迎前往 [GitHub 仓库](https://github.com/TianQuanDiWen/MaDOAXVV) 点亮一颗 Star 给予支持！使用遇到异常请在 [Issues 反馈区](https://github.com/TianQuanDiWen/MaDOAXVV/issues) 附带 `debug/` 日志提交。",
    "github": "https://github.com/TianQuanDiWen/MaDOAXVV",
    "version": "0.1.0",
    "pretask": {
        "name": "启动游戏",
        "label": "🚀 启动游戏",
        "description": "通过 Steam 启动游戏，在启动器中识别并点击“开始游戏”，等待游戏窗口就绪后再连接。",
        "exec": "go",
        "args": [
            "run",
            "../agent/cmd/madoaxvv-agent",
            "launch-game",
            "--root",
            "..",
            "--steam-uri",
            "steam://rungameid/958260",
            "--launcher-process",
            "DOAX_VV_Launcher.exe",
            "--game-window",
            "^DOAX VenusVacation$",
            "--timeout",
            "300s"
        ],
        "controller": [
            "前台模式",
            "后台模式"
            
            
        ]
    },
    "agent": {
        "identifier": "pi-agent-1",
        "child_exec": "go",
        "child_args": [
            "run",
            "../agent/cmd/madoaxvv-agent",
            "agent",
            "--root",
            ".."
        ]
    },
    "controller": [
        {
            "name": "前台模式",
            "label": "前台模式",
            "description": "前台操作，每步操作移动鼠标位置，运行时会占用真实鼠标键盘。",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "^DOAX VenusVacation$",
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "Seize"
            }
        },
        {
            "name": "后台模式",
            "type": "Win32",
            "description": "后台操作，防检测不友好，弹无限金球概率高，推荐在右上连接设置-控制器-选项里选择使用前台模式",
            "win32": {
                "class_regex": ".*",
                "window_regex": "^DOAX VenusVacation$",
                "screencap": "FramePool",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "国际服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "__MXU_PRETASK__启动游戏",
            "label": "🚀 启动游戏",
            "entry": "Launcher_ClickStartGame",
            "description": "通过 Steam 启动游戏，在启动器中识别并点击“开始游戏”，等待游戏窗口就绪后再连接。",
            "controller": [
                "前台模式",
                "后台模式"
            ]
        },
        {
            "name": "登陆游戏",
            "label": "🔑 登录游戏",
            "entry": "登陆游戏_开始",
            "description": "进入到主页前自动点击，领取每日签到奖励和关闭公告"
        },
        {
            "name": "抽免费券",
            "label": "🎁 抽免费券",
            "entry": "抽免费券_开始",
            "description": "会自动抽免费券，判断依据是扭蛋图标旁边的免费文字（通过文字识别）"
        },
        {
            "name": "岛主房间",
            "label": "♨️ 岛主房间",
            "entry": "岛主房间_开始",
            "description": "自动领温泉并补充温泉剂，工作完成自动收菜并继续工作"
        },
        {
            "name": "自动打新比赛",
            "label": "⚔️ 自动打新比赛",
            "entry": "新比赛_开始",
            "description": "有新比赛的情况下会自动打，直到打不过或者弹出金球验证为止",
            "option": [
                "新比赛_作战指示"
            ]
        },
        {
            "name": "每日自动挑战券",
            "label": "🎫 每日自动挑战券",
            "entry": "每日挑战_开始",
            "description": "每日自动领取挑战券，用自动战斗打三次，只认SS级自动挑战券"
        },
        {
            "name": "每日活动挑战赛",
            "label": "🔥 每日活动挑战赛",
            "entry": "日活动赛_开始",
            "description": "每日自动参与活动挑战赛，用自动挑战券打，目前只识别sss+，识别不到不会自动执行"
        },
        {
            "name": "自动排位",
            "label": "🏆 自动排位",
            "entry": "排位_开始",
            "description": "自动打排位赛，打够次数为止，弹出金球验证会提前结束",
            "option": [
                "排位_跳过开启"
            ]
        },
        {
            "name": "领取邮件与任务奖励",
            "label": "📬 领取邮件与任务奖励",
            "entry": "领取_开始",
            "description": "领取邮件和任务奖励"
        },
        {
            "name": "赌场",
            "label": "🎰 赌场",
            "entry": "赌场_开始",
            "description": "打满赌场奖励，流程还在测试中，目前打满的判断条件是打够24000金筹码"
        },
        {
            "name": "退出游戏",
            "label": "🚪 退出游戏",
            "entry": "退出游戏_开始",
            "description": "通过游戏内的退出选项退出游戏"
        }
    ],
    "option": {
        "排位_跳过开启": {
            "label": "跳过对战",
            "type": "switch",
            "description": "是否在排位赛中跳过对战画面（点击 ALLSKIP 跳过本场）",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "排位_跳过开启": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "排位_跳过开启": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "新比赛_作战指示": {
            "label": "作战指示",
            "type": "switch",
            "description": "是否在比赛准备界面设置作战指示",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": [
                        "新比赛_攻击方法",
                        "新比赛_攻击手",
                        "新比赛_攻击目标"
                    ],
                    "pipeline_override": {
                        "新比赛_作战指示": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "新比赛_作战指示": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "新比赛_攻击方法": {
            "label": "攻击方法",
            "type": "select",
            "description": "设置排球进攻方式（杀球或佯攻）",
            "cases": [
                {
                    "name": "任意",
                    "label": "任意",
                    "description": "不修改攻击方法（跳过该节点）",
                    "pipeline_override": {
                        "新比赛_攻击方法": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "杀球",
                    "label": "杀球",
                    "pipeline_override": {
                        "新比赛_攻击方法": {
                            "enabled": true,
                            "next": [
                                "新比赛_攻击方法-杀球"
                            ]
                        },
                        "新比赛_攻击方法-杀球": {
                            "enabled": true
                        },
                        "新比赛_攻击方法-佯攻": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "佯攻",
                    "label": "佯攻",
                    "pipeline_override": {
                        "新比赛_攻击方法": {
                            "enabled": true,
                            "next": [
                                "新比赛_攻击方法-佯攻"
                            ]
                        },
                        "新比赛_攻击方法-杀球": {
                            "enabled": false
                        },
                        "新比赛_攻击方法-佯攻": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "新比赛_攻击手": {
            "label": "主攻击手",
            "type": "select",
            "description": "选择主攻击手站位（一号位或二号位）",
            "cases": [
                {
                    "name": "任意",
                    "label": "任意",
                    "description": "不修改主攻手（跳过该节点）",
                    "pipeline_override": {
                        "新比赛_攻击手": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "一号位",
                    "label": "一号位",
                    "pipeline_override": {
                        "新比赛_攻击手": {
                            "enabled": true,
                            "next": [
                                "新比赛_攻击手-一号位"
                            ]
                        },
                        "新比赛_攻击手-一号位": {
                            "enabled": true
                        },
                        "新比赛_攻击手-二号位": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "二号位",
                    "label": "二号位",
                    "pipeline_override": {
                        "新比赛_攻击手": {
                            "enabled": true,
                            "next": [
                                "新比赛_攻击手-二号位"
                            ]
                        },
                        "新比赛_攻击手-一号位": {
                            "enabled": false
                        },
                        "新比赛_攻击手-二号位": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "新比赛_攻击目标": {
            "label": "攻击目标",
            "type": "select",
            "description": "选择对方防守薄弱目标（一号位或二号位）",
            "cases": [
                {
                    "name": "任意",
                    "label": "任意",
                    "description": "不修改攻击目标（跳过该节点）",
                    "pipeline_override": {
                        "新比赛_攻击目标": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "一号位",
                    "label": "一号位",
                    "pipeline_override": {
                        "新比赛_攻击目标": {
                            "enabled": true,
                            "next": [
                                "新比赛_攻击目标-一号位"
                            ]
                        },
                        "新比赛_攻击目标-一号位": {
                            "enabled": true
                        },
                        "新比赛_攻击目标-二号位": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "二号位",
                    "label": "二号位",
                    "pipeline_override": {
                        "新比赛_攻击目标": {
                            "enabled": true,
                            "next": [
                                "新比赛_攻击目标-二号位"
                            ]
                        },
                        "新比赛_攻击目标-一号位": {
                            "enabled": false
                        },
                        "新比赛_攻击目标-二号位": {
                            "enabled": true
                        }
                    }
                }
            ]
        }
    },
    "preset": [
        {
            "name": "默认配置",
            "label": "默认配置",
            "task": [
                {
                    "name": "__MXU_PRETASK__启动游戏",
                    "enabled": true
                },
                {
                    "name": "登陆游戏",
                    "enabled": true
                },
                {
                    "name": "抽免费券",
                    "enabled": true
                },
                {
                    "name": "岛主房间",
                    "enabled": true
                },
                {
                    "name": "自动打新比赛",
                    "enabled": true,
                    "option": {
                        "新比赛_作战指示": "No",
                        "新比赛_攻击方法": "任意",
                        "新比赛_攻击手": "任意",
                        "新比赛_攻击目标": "任意"
                    }
                },
                {
                    "name": "每日自动挑战券",
                    "enabled": true
                },
                {
                    "name": "每日活动挑战赛",
                    "enabled": true
                },
                {
                    "name": "自动排位",
                    "enabled": true,
                    "option": {
                        "排位_跳过开启": "Yes"
                    }
                },
                {
                    "name": "领取邮件与任务奖励",
                    "enabled": true
                },
                {
                    "name": "赌场",
                    "enabled": true
                },
                {
                    "name": "退出游戏",
                    "enabled": true
                }
            ]
        }
    ]
}
